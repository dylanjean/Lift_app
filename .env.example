# Supabase — Project Settings → API in the dashboard.
# Copy to .env.local (gitignored) and fill in real values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key — seed script only (scripts/seed.ts). SECRET: bypasses
# RLS. Deliberately no VITE_ prefix so Vite can never bundle it client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
